rules_version = '2';

// Farm System V1 foundation: all client Firestore access is denied.
// V1 business writes will be performed through Cloud Functions using the
// Admin SDK. Public Passport access is not implemented in this phase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
