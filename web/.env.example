# Public Firebase client configuration. Supply Production values only in the
# Production build environment; these are not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local/DEV-only. Leave unset (or anything other than true) for Production.
VITE_USE_FIREBASE_EMULATORS=
