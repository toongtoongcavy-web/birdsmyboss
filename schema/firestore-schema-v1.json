{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Farm System V1 Canonical Firestore Schema",
  "version": "1.0.0-stage-1",
  "conventions": {
    "documentId": "UUID generated by the trusted write path unless specified otherwise",
    "timestamp": "Firestore Timestamp",
    "date": "ISO-8601 calendar date YYYY-MM-DD",
    "reference": "String containing a Firestore document ID",
    "retention": "Historical records are archived or superseded; never hard-deleted"
  },
  "architecturePolicies": {
    "referenceConvention": "All references are canonical string document IDs. Trusted writes validate document existence, entity type, and permitted relationship. Firestore DocumentReference values are not used.",
    "trustedWritePath": {
      "implementation": "Cloud Functions",
      "flow": "UI -> Cloud Functions -> business validation -> Firestore transaction -> Firestore",
      "clientValidationSecurityBoundary": false,
      "minimumOperations": ["activatePair", "assignPairToCage", "createBirdFromEgg", "checkRingIdAvailability", "completeSale", "refundPayment", "completeHandover"]
    },
    "ringIdNormalization": {
      "trimLeadingTrailingWhitespace": true,
      "casePolicy": "locale-independent uppercase",
      "storedValue": "canonical normalized value",
      "immutableAfterCreate": true,
      "doesNotTransformInternalCharacters": true,
      "internalSeparatorEquivalence": {"GC-001=gc-001": true, "GC-001=GC 001": false, "GC-001=GC001": false}
    },
    "kinshipPolicy": {
      "pedigreeSource": "BIRD -> EGG -> BREEDING_CYCLE -> PAIR -> PAIR_MEMBER -> BIRD",
      "forbiddenSource": ["birds.fatherId", "birds.motherId"],
      "policy": "C",
      "block": ["parent_x_offspring", "sibling_x_sibling"],
      "warn": ["other_detectable_kinship"],
      "unknown": "insufficient pedigree information; do not infer relationship",
      "numericalInbreedingAlgorithm": "not specified or required in V1"
    },
    "ownerTypeAllowList": {
      "status": "locked",
      "arbitraryStringsAllowed": false,
      "approvedValues": ["BIRD", "PAIR", "CUSTOMER", "SALE", "RESERVATION", "DELIVERY", "HANDOVER"]
    },
    "passport": {
      "isCollection": false,
      "isDuplicateEntity": false,
      "resolver": "birds.publicToken",
      "publicFields": ["bird photo", "ringId", "mutation", "birth/hatch date", "sex when available", "origin", "safe parentage information", "handover date", "passportStatus"],
      "privateByDefault": ["customer contact information", "customer address", "payment information", "internal notes", "internal operational information", "unauthorized price or transaction data"]
    },
    "reservationDepositDisposition": {"onCancelledOrExpired":"operator chooses full_refund, partial_refund, or no_refund","partialRefundRequires":["amount","reason","transaction date"],"automaticRefundByCancellationReason":false,"originalPaymentRetention":true},
    "implementationSupportCollections": {"assetIntakes":{"canonicalBusinessCollection":false,"access":"private trusted-server operational state only","publicPassportData":false,"purpose":"server-authorized Bird asset intake/finalization state"}}
  },
  "relationships": [
    "PAIR -> PAIR_MEMBER",
    "PAIR -> CAGE_ASSIGNMENT -> CAGE",
    "PAIR -> BREEDING_CYCLE -> EGG -> 0..1 BIRD"
  ],
  "collections": {
    "cages": {"entity":"CAGE","documentId":"cageId","fields":{"code":{"type":"string","required":true,"immutable":true,"unique":true},"name":{"type":"string","required":true},"status":{"type":"enum(active,inactive,maintenance)","required":true},"location":{"type":"string","required":false},"capacity":{"type":"number","required":false},"notes":{"type":"string","required":false}},"sourceOfTruth":"Cage identity and status; occupancy is cageAssignments","validation":["code unique","no overlapping cageAssignments for cageId"]},
    "pairs": {"entity":"PAIR","documentId":"pairId","fields":{"status":{"type":"enum(draft,active,inactive,retired)","required":true},"startedOn":{"type":"date","required":true,"immutable":true},"endedOn":{"type":"date","required":false},"name":{"type":"string","required":false},"notes":{"type":"string","required":false}},"sourceOfTruth":"Pair lifecycle; membership is pairMembers","validation":["active pair has exactly one active male and one active female pairMember","one active cage assignment at a time"]},
    "pairMembers": {"entity":"PAIR_MEMBER","documentId":"pairMemberId","fields":{"pairId":{"type":"reference:pairs","required":true,"immutable":true},"birdId":{"type":"reference:birds","required":true,"immutable":true},"role":{"type":"enum(male,female)","required":true,"immutable":true},"effectiveFrom":{"type":"date","required":true,"immutable":true},"effectiveTo":{"type":"date","required":false},"endedReason":{"type":"string","required":false}},"sourceOfTruth":"Parent role membership of a pair","validation":["two distinct birds per active pair","bird has no overlapping active pair membership","role agrees with current sex evidence"]},
    "cageAssignments": {"entity":"CAGE_ASSIGNMENT","documentId":"cageAssignmentId","fields":{"pairId":{"type":"reference:pairs","required":true,"immutable":true},"cageId":{"type":"reference:cages","required":true,"immutable":true},"startsOn":{"type":"date","required":true,"immutable":true},"endsOn":{"type":"date","required":false},"endedReason":{"type":"string","required":false},"notes":{"type":"string","required":false}},"sourceOfTruth":"Temporal cage/pair placement","validation":["no overlap by cageId","no overlap by pairId","endsOn >= startsOn"]},
    "breedingCycles": {"entity":"BREEDING_CYCLE","documentId":"breedingCycleId","fields":{"pairId":{"type":"reference:pairs","required":true,"immutable":true},"startedOn":{"type":"date","required":true,"immutable":true},"status":{"type":"enum(planned,active,closed,cancelled)","required":true},"code":{"type":"string","required":false},"endedOn":{"type":"date","required":false},"notes":{"type":"string","required":false}},"sourceOfTruth":"Cycle ownership and lifecycle","validation":["pair valid at startedOn","endedOn >= startedOn"]},
    "eggs": {"entity":"EGG","documentId":"eggId","fields":{"cycleId":{"type":"reference:breedingCycles","required":true,"immutable":true},"sequenceNo":{"type":"integer","required":true,"immutable":true},"laidOn":{"type":"date","required":true,"immutable":true},"status":{"type":"enum(laid,fertile,infertile,hatched,lost,discarded)","required":true},"candledOn":{"type":"date","required":false},"expectedHatchOn":{"type":"date","required":false},"notes":{"type":"string","required":false}},"sourceOfTruth":"Egg identity and state","validation":["sequenceNo positive and unique per cycle","at most one bird references this eggId"]},
    "birds": {"entity":"BIRD","documentId":"birdId","fields":{"ringId":{"type":"string","required":true,"immutable":true,"unique":true},"origin":{"type":"enum(farm_hatched,purchased,external,rescued,unknown)","required":true,"immutable":true},"eggId":{"type":"reference:eggs","requiredWhen":"origin=farm_hatched","immutable":true},"status":{"type":"enum(active,reserved,sold,given_away,deceased,retired)","required":true},"displayName":{"type":"string","required":true},"species":{"type":"string","required":false},"mutation":{"type":"string","required":false},"hatchedOn":{"type":"date","required":false},"acquiredOn":{"type":"date","required":false},"passportStatus":{"type":"enum(draft,published,disabled)","required":true},"publicToken":{"type":"string","required":false,"unique":true},"notes":{"type":"string","required":false}},"sourceOfTruth":"Individual bird; eggId is canonical farm-hatched origin","forbiddenFields":["fatherId","motherId"],"validation":["ringId globally unique","eggId has at most one bird","parentage derived from egg chain","publicToken server-generated with at least 128 bits entropy"]},
    "photos": {"entity":"PHOTO","documentId":"photoId","fields":{"ownerType":{"type":"enum(BIRD,PAIR,CUSTOMER,SALE,RESERVATION,DELIVERY,HANDOVER)","required":true,"immutable":true},"ownerId":{"type":"reference","required":true,"immutable":true},"storagePath":{"type":"string","required":true,"immutable":true},"status":{"type":"enum(active,archived)","required":true},"isPublicOnPassport":{"type":"boolean","required":true,"default":false},"managedStorage":{"type":"boolean","required":true,"immutable":true},"caption":{"type":"string","required":false},"takenOn":{"type":"date","required":false},"sortOrder":{"type":"integer","required":false},"contentType":{"type":"string","required":false},"checksum":{"type":"string","required":false}},"sourceOfTruth":"Photo metadata","validation":["ownerType is one of the locked finite allow-list values","storagePath immutable","new Bird assets use verified server-controlled Storage intake"]},
    "weightHistory": {"entity":"WEIGHT_HISTORY","documentId":"weightEntryId","fields":{"birdId":{"type":"reference:birds","required":true,"immutable":true},"measuredOn":{"type":"date","required":true,"immutable":true},"weightGrams":{"type":"number","required":true,"immutable":true},"recordedAt":{"type":"timestamp","required":true,"immutable":true},"notes":{"type":"string","required":false,"immutable":true},"source":{"type":"string","required":false,"immutable":true}},"sourceOfTruth":"Append-only bird weights","validation":["weightGrams > 0"]},
    "sexHistory": {"entity":"SEX_HISTORY","documentId":"sexHistoryId","fields":{"birdId":{"type":"reference:birds","required":true,"immutable":true},"sex":{"type":"enum(male,female,unknown)","required":true,"immutable":true},"determinedOn":{"type":"date","required":true,"immutable":true},"method":{"type":"enum(dna,sex_linked,visual,unknown)","required":true,"immutable":true},"evidenceDocumentId":{"type":"reference:documents","required":false,"immutable":true},"notes":{"type":"string","required":false,"immutable":true}},"sourceOfTruth":"Sex evidence history","validation":["append-only"]},
    "documents": {"entity":"DOCUMENT","documentId":"documentId","fields":{"ownerType":{"type":"enum(BIRD,PAIR,CUSTOMER,SALE,RESERVATION,DELIVERY,HANDOVER)","required":true,"immutable":true},"ownerId":{"type":"reference","required":true,"immutable":true},"documentType":{"type":"string","required":true,"immutable":true},"storagePath":{"type":"string","required":true,"immutable":true},"issuedOn":{"type":"date","required":true,"immutable":true},"status":{"type":"enum(active,archived,superseded)","required":true},"isPublicOnPassport":{"type":"boolean","required":true,"default":false},"managedStorage":{"type":"boolean","required":true,"immutable":true},"supersededByDocumentId":{"type":"reference:documents","required":false,"immutable":true},"expiresOn":{"type":"date","required":false},"documentNumber":{"type":"string","required":false},"checksum":{"type":"string","required":false},"notes":{"type":"string","required":false}},"sourceOfTruth":"Document metadata","validation":["ownerType is one of the locked finite allow-list values","new Bird assets use verified server-controlled Storage intake","no Passport collection; Passport is a view"]},
    "priceHistory": {"entity":"PRICE_HISTORY","documentId":"priceHistoryId","fields":{"birdId":{"type":"reference:birds","required":true,"immutable":true},"amount":{"type":"number","required":true,"immutable":true},"currency":{"type":"enum(THB)","required":true,"immutable":true},"effectiveOn":{"type":"date","required":true,"immutable":true},"kind":{"type":"enum(list,offer,final)","required":true,"immutable":true},"validUntil":{"type":"date","required":false,"immutable":true},"notes":{"type":"string","required":false,"immutable":true}},"sourceOfTruth":"Append-only informational bird price history","validation":["amount is finite and >= 0","overlapping entries are allowed","never automatically selected or propagated"]},
    "customers": {"entity":"CUSTOMER","documentId":"customerId","fields":{"displayName":{"type":"string","required":true},"phone":{"type":"string","required":false},"email":{"type":"string","required":false},"address":{"type":"string","required":false},"notes":{"type":"string","required":false},"status":{"type":"enum(active,archived)","required":false}},"sourceOfTruth":"Customer identity","validation":["completed transactions retain their own required snapshots"]},
    "reservations": {"entity":"RESERVATION","documentId":"reservationId","fields":{"birdId":{"type":"reference:birds","required":true,"immutable":true},"customerId":{"type":"reference:customers","required":true,"immutable":true},"reservedOn":{"type":"date","required":true,"immutable":true},"status":{"type":"enum(active,completed,cancelled,expired)","required":true},"expiresOn":{"type":"date","required":false},"agreedPrice":{"type":"number","required":false,"immutable":true},"currency":{"type":"enum(THB)","required":false,"immutable":true},"notes":{"type":"string","required":false},"cancelReason":{"type":"string","required":false}},"sourceOfTruth":"Reservation lifecycle and optional immutable agreement snapshot","validation":["one active reservation per bird","deposit is payment linked by reservationId","agreedPrice and currency supplied together or omitted together","agreedPrice is finite decimal > 0","missing price is not zero/free","priceHistory is never resolved automatically"]},
    "sales": {"entity":"SALE","documentId":"saleId","fields":{"birdId":{"type":"reference:birds","required":true,"immutable":true},"customerId":{"type":"reference:customers","required":true,"immutable":true},"createdOn":{"type":"date","required":true,"immutable":true},"status":{"type":"enum(draft,confirmed,completed,cancelled)","required":true},"reservationId":{"type":"reference:reservations","required":false,"immutable":true},"completedOn":{"type":"date","required":false},"agreedPrice":{"type":"number","required":false,"immutable":true},"currency":{"type":"enum(THB)","required":false,"immutable":true},"notes":{"type":"string","required":false},"cancelReason":{"type":"string","required":false}},"sourceOfTruth":"Sale lifecycle and optional immutable agreement snapshot","validation":["maximum one completed sale per bird","completion is transactional","no hard delete","agreedPrice and currency supplied together or omitted together","agreedPrice is finite decimal > 0","direct sale accepts explicit snapshot only","reservation conversion copies reservation snapshot exactly and rejects caller repricing"]},
    "payments": {"entity":"PAYMENT","documentId":"paymentId","fields":{"saleId":{"type":"reference:sales","requiredExactlyOneOf":"saleId,reservationId","immutable":true},"reservationId":{"type":"reference:reservations","requiredExactlyOneOf":"saleId,reservationId","immutable":true},"customerId":{"type":"reference:customers","required":false,"immutable":true},"purpose":{"type":"enum(deposit,sale_payment,other)","required":true,"immutable":true},"amount":{"type":"number","required":true,"immutable":true},"currency":{"type":"string","required":true,"immutable":true},"receivedOn":{"type":"date","required":true,"immutable":true},"paymentMethod":{"type":"string","required":true,"immutable":true},"status":{"type":"enum(received,voided)","required":true},"referenceNo":{"type":"string","required":false,"immutable":true},"notes":{"type":"string","required":false,"immutable":true}},"sourceOfTruth":"Payment receipt","validation":["amount > 0","deposit requires reservationId"]},
    "refunds": {"entity":"REFUND","documentId":"refundId","fields":{"paymentId":{"type":"reference:payments","required":true,"immutable":true},"amount":{"type":"number","required":true,"immutable":true},"refundedOn":{"type":"date","required":true,"immutable":true},"outcome":{"type":"enum(full_refund,partial_refund,no_refund)","required":true,"immutable":true},"reason":{"type":"string","required":true,"immutable":true},"notes":{"type":"string","required":false,"immutable":true}},"sourceOfTruth":"Refund history","validation":["sum(refund.amount) <= payment.amount","no_refund amount=0","partial_refund requires actual amount > 0"]},
    "giveaways": {"entity":"GIVEAWAY","documentId":"giveawayId","fields":{"birdId":{"type":"reference:birds","required":true,"immutable":true},"recipientName":{"type":"string","required":true,"immutable":true},"givenOn":{"type":"date","required":true,"immutable":true},"status":{"type":"enum(planned,completed,cancelled)","required":true},"customerId":{"type":"reference:customers","required":false,"immutable":true},"handoverId":{"type":"reference:handovers","required":false},"notes":{"type":"string","required":false}},"sourceOfTruth":"Non-sale transfer lifecycle","validation":["completed giveaway excludes completed sale for bird","no hard delete"]},
    "deliveries": {"entity":"DELIVERY","documentId":"deliveryId","fields":{"saleId":{"type":"reference:sales","required":true,"immutable":true},"distanceKm":{"type":"number","required":true,"immutable":true},"freeDistanceKm":{"type":"number","required":true,"immutable":true},"pricePerKm":{"type":"number","required":true,"immutable":true},"shippingFee":{"type":"number","required":true,"immutable":true,"derivedByTrustedWrite":"max(distanceKm - freeDistanceKm, 0) * pricePerKm"},"currency":{"type":"string","required":true,"immutable":true},"createdOn":{"type":"date","required":true,"immutable":true},"status":{"type":"enum(planned,in_transit,delivered,cancelled)","required":true},"deliveredOn":{"type":"date","required":false},"addressSnapshot":{"type":"object","required":false,"immutable":true},"notes":{"type":"string","required":false}},"sourceOfTruth":"Historical delivery fee and status for one completed Sale","validation":["saleId references a completed sale","V1 does not support giveawayId or handoverId delivery ownership","distanceKm, freeDistanceKm, and pricePerKm are finite and non-negative","shippingFee is derived by trusted write and cannot be overridden by client","shippingFee not recomputed later from global config"]},
    "handovers": {"entity":"HANDOVER","documentId":"handoverId","fields":{"birdId":{"type":"reference:birds","required":true,"immutable":true},"handoverOn":{"type":"date","required":true,"immutable":true},"recipientSnapshot":{"type":"object{name:string,phone?:string,address?:string}","required":true,"immutable":true},"sourceType":{"type":"enum(sale,giveaway,other)","required":true,"immutable":true},"status":{"type":"enum(planned,completed,cancelled)","required":true},"saleId":{"type":"reference:sales","required":false,"immutable":true},"giveawayId":{"type":"reference:giveaways","required":false,"immutable":true},"deliveryId":{"type":"reference:deliveries","required":false,"immutable":true},"parentageSnapshot":{"type":"object","required":false,"immutable":true},"notes":{"type":"string","required":false,"immutable":true}},"sourceOfTruth":"Historical custody transfer","validation":["recipientSnapshot accepts only name, phone, address","parentageSnapshot is historical only","no hard delete"]},
    "saleTimeline": {"entity":"SALE_TIMELINE","documentId":"saleTimelineId","fields":{"saleId":{"type":"reference:sales","required":true,"immutable":true},"eventType":{"type":"string","required":true,"immutable":true},"occurredAt":{"type":"timestamp","required":true,"immutable":true},"actorId":{"type":"string","required":true,"immutable":true},"payload":{"type":"object","required":false,"immutable":true},"note":{"type":"string","required":false,"immutable":true}},"sourceOfTruth":"Append-only sale event history","validation":["saleId required; no reservation-only timeline events","does not replace sales.status","operator-only Sale-detail chronological read","no hard delete"]}
  },
  "commonAuditFields": {"createdAt":{"type":"timestamp","required":true,"immutable":true},"updatedAt":{"type":"timestamp","required":true},"createdBy":{"type":"string","required":true,"immutable":true},"updatedBy":{"type":"string","required":true},"archivedAt":{"type":"timestamp","required":false},"archivedBy":{"type":"string","required":false}}
}
